generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENCY_OWNER
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Currency {
  TRY
  USD
  EUR
  GBP
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  COMMERCIAL
  OFFICE
  BUILDING
  OTHER
}

enum ListingStatus {
  DRAFT
  PUBLISHING
  ACTIVE
  ARCHIVED
}

enum ListingMediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
  DOCUMENT
}

enum ConnectionStatus {
  NOT_TESTED
  CONNECTED
  DISCONNECTED
  FAILED
}

enum PublicationStatus {
  PENDING
  QUEUED
  PROCESSING
  PUBLISHED
  UPDATE_REQUIRED
  FAILED
  UNPUBLISHED
}

enum PublicationAction {
  CREATE
  UPDATE
  UNPUBLISH
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum FeatureCategory {
  FACADE
  INTERIOR
  EXTERIOR
  NEARBY
  TRANSPORTATION
  VIEW
  ACCESSIBILITY
}

enum HeatingType {
  NONE
  CENTRAL
  COMBI_BOILER
  UNDERFLOOR
  STOVE
  AIR_CONDITIONING
  GEOTHERMAL
  SOLAR
  OTHER
}

enum KitchenType {
  OPEN
  CLOSED
  AMERICAN
  OTHER
}

enum ParkingType {
  NONE
  OPEN
  COVERED
  GARAGE
  VALET
  OTHER
}

enum OccupancyStatus {
  VACANT
  OWNER_OCCUPIED
  TENANT_OCCUPIED
  UNDER_CONSTRUCTION
}

enum EnergyCertificate {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum TitleDeedStatus {
  OWNERSHIP
  CONDOMINIUM_EASEMENT
  CONSTRUCTION_SERVITUDE
  LAND_TITLE
  OTHER
}

enum AdvertiserType {
  OWNER
  AGENT
  AGENCY
  DEVELOPER
}

enum HousingType {
  APARTMENT
  VILLA
  DETACHED_HOUSE
  RESIDENCE
  SUMMER_HOUSE
  LOFT
  DUPLEX
  PENTHOUSE
  STUDIO
  OTHER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole       @default(AGENT)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  listings      Listing[]
  portalAccounts UserPortalAccount[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Plan {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique
  monthlyPrice   Decimal        @db.Decimal(12, 2)
  listingLimit   Int
  portalLimit    Int
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  planId    String             @db.Uuid
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime
  expiresAt DateTime?
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  @@index([userId, status])
  @@index([planId])
}

model Listing {
  id           String          @id @default(uuid()) @db.Uuid
  listingNo    String          @unique @default(cuid())
  ownerId      String          @db.Uuid
  title        String
  description  String          @db.Text
  price        Decimal         @db.Decimal(14, 2)
  currency     Currency        @default(TRY)
  listingType  ListingType
  propertyType PropertyType
  city         String
  district     String
  neighborhood String?
  address      String
  latitude     Decimal?        @db.Decimal(10, 7)
  longitude    Decimal?        @db.Decimal(10, 7)
  status       ListingStatus   @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media        ListingMedia[]
  publications ListingPublication[]
  residentialDetails ResidentialDetails?
  features     ListingFeature[]
  @@index([ownerId, status])
  @@index([city, district])
}

model ResidentialDetails {
  listingId          String             @id @db.Uuid
  grossArea          Decimal?           @db.Decimal(10, 2)
  netArea            Decimal?           @db.Decimal(10, 2)
  roomCount          String?
  buildingAge        Int?
  floorNumber        Int?
  totalFloors        Int?
  heatingType        HeatingType?
  bathroomCount      Int?
  kitchenType        KitchenType?
  hasBalcony         Boolean?
  hasElevator        Boolean?
  parkingType        ParkingType?
  isFurnished        Boolean?
  occupancyStatus    OccupancyStatus?
  isInComplex        Boolean?
  complexName        String?
  monthlyFee         Decimal?           @db.Decimal(12, 2)
  isCreditEligible   Boolean?
  energyCertificate  EnergyCertificate?
  titleDeedStatus    TitleDeedStatus?
  advertiserType     AdvertiserType?
  isExchangeAccepted Boolean?
  housingType        HousingType?
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model FeatureDefinition {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  label     String
  category  FeatureCategory
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  listings  ListingFeature[]
  @@index([category, isActive])
}

model ListingFeature {
  listingId           String            @db.Uuid
  featureDefinitionId String            @db.Uuid
  listing             Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  featureDefinition   FeatureDefinition @relation(fields: [featureDefinitionId], references: [id], onDelete: Restrict)
  @@id([listingId, featureDefinitionId])
  @@index([featureDefinitionId])
}

model ListingMedia {
  id        String           @id @default(uuid()) @db.Uuid
  listingId String           @db.Uuid
  type      ListingMediaType @default(IMAGE)
  url       String
  storageKey String           @default("")
  originalName String?
  mimeType String             @default("image/webp")
  fileSize Int                @default(0)
  width Int?
  height Int?
  sortOrder Int              @default(0)
  isCover   Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([listingId, sortOrder])
}

model Portal {
  id           String                @id @default(uuid()) @db.Uuid
  code         String                @unique
  name         String
  adapterKey   String                @unique
  isActive     Boolean               @default(true)
  connectionType String               @default("REST_API")
  credentialSchema Json?
  documentationUrl String?
  logoUrl      String?
  userAccounts UserPortalAccount[]
  publications ListingPublication[]
}

model UserPortalAccount {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @db.Uuid
  portalId             String           @db.Uuid
  credentialsEncrypted String           @db.Text
  connectionStatus     ConnectionStatus @default(NOT_TESTED)
  lastCheckedAt        DateTime?
  lastError            String?          @db.Text
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal               Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  @@unique([userId, portalId])
  @@index([portalId, connectionStatus])
}

model ListingPublication {
  id                String            @id @default(uuid()) @db.Uuid
  listingId         String            @db.Uuid
  portalId          String            @db.Uuid
  status            PublicationStatus @default(PENDING)
  externalListingId String?
  externalUrl       String?
  lastError         String?           @db.Text
  publishedAt       DateTime?
  updatedAt         DateTime          @updatedAt
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  portal            Portal            @relation(fields: [portalId], references: [id], onDelete: Restrict)
  attempts          PublicationAttempt[]
  @@unique([listingId, portalId])
  @@index([portalId, status])
}

model PublicationAttempt {
  id                    String              @id @default(uuid()) @db.Uuid
  listingPublicationId  String              @db.Uuid
  action                PublicationAction
  status                AttemptStatus       @default(STARTED)
  attemptNumber         Int
  requestPayload        Json?
  responsePayload       Json?
  errorMessage          String?             @db.Text
  createdAt             DateTime            @default(now())
  listingPublication    ListingPublication  @relation(fields: [listingPublicationId], references: [id], onDelete: Cascade)
  @@unique([listingPublicationId, action, attemptNumber])
  @@index([listingPublicationId, createdAt])
}
