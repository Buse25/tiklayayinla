generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum OrganizationType {
  REAL_ESTATE_AGENCY
  AUTO_DEALER
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  PASSIVE
}

enum OrganizationApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationRole {
  OWNER
  MANAGER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PASSIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Currency {
  TRY
  USD
  EUR
  GBP
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  COMMERCIAL
  OFFICE
  BUILDING
  OTHER
}

enum ListingStatus {
  DRAFT
  PUBLISHING
  ACTIVE
  ARCHIVED
}

enum ListingMediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
  DOCUMENT
}

enum ConnectionStatus {
  NOT_TESTED
  CONNECTED
  DISCONNECTED
  FAILED
}

enum PublicationStatus {
  PENDING
  QUEUED
  PROCESSING
  PUBLISHED
  UPDATE_REQUIRED
  FAILED
  UNPUBLISHED
}

enum PublicationAction {
  CREATE
  UPDATE
  UNPUBLISH
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum AuditAction {
  EMAIL_VERIFICATION_CODE_SENT
  EMAIL_VERIFICATION_SUCCEEDED
  EMAIL_VERIFICATION_FAILED
  EMAIL_VERIFICATION_RESENT
  MAIL_DELIVERY_FAILED
  LISTING_CREATED
  LISTING_UPDATED
  LISTING_DELETED
  LISTING_ARCHIVED
  LISTING_RESTORED
  LISTING_PUBLISHED
  LISTING_REPUBLISHED
  PORTAL_ACCOUNT_CREATED
  PORTAL_ACCOUNT_UPDATED
  PORTAL_ACCOUNT_DELETED
  PORTAL_ACCOUNT_CONNECTION_TESTED
  USER_PROFILE_UPDATED
  IMPORT_CONFIRMED
  ORGANIZATION_CREATED
  ORGANIZATION_MEMBERSHIP_CREATED
  ORGANIZATION_APPLICATION_CREATED
  ORGANIZATION_APPLICATION_APPROVED
  ORGANIZATION_APPLICATION_REJECTED
  ORGANIZATION_APPLICATION_EDITED
}

enum AuditEntityType {
  LISTING
  PORTAL_ACCOUNT
  USER
  IMPORT_BATCH
  ORGANIZATION
}

enum FeatureCategory {
  FACADE
  INTERIOR
  EXTERIOR
  NEARBY
  TRANSPORTATION
  VIEW
  ACCESSIBILITY
}

enum HeatingType {
  NONE
  CENTRAL
  COMBI_BOILER
  UNDERFLOOR
  STOVE
  AIR_CONDITIONING
  GEOTHERMAL
  SOLAR
  OTHER
}

enum KitchenType {
  OPEN
  CLOSED
  AMERICAN
  OTHER
}

enum ParkingType {
  NONE
  OPEN
  COVERED
  GARAGE
  VALET
  OTHER
}

enum OccupancyStatus {
  VACANT
  OWNER_OCCUPIED
  TENANT_OCCUPIED
  UNDER_CONSTRUCTION
}

enum EnergyCertificate {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum TitleDeedStatus {
  OWNERSHIP
  CONDOMINIUM_EASEMENT
  CONSTRUCTION_SERVITUDE
  LAND_TITLE
  OTHER
}

enum AdvertiserType {
  OWNER
  AGENT
  AGENCY
  DEVELOPER
}

enum HousingType {
  APARTMENT
  VILLA
  DETACHED_HOUSE
  RESIDENCE
  SUMMER_HOUSE
  LOFT
  DUPLEX
  PENTHOUSE
  STUDIO
  OTHER
}

model User {
  id                               String                    @id @default(uuid()) @db.Uuid
  email                            String                    @unique
  passwordHash                     String
  firstName                        String
  lastName                         String
  phone                            String?
  about                            String?                   @db.Text
  address                          String?                   @db.Text
  role                             UserRole                  @default(USER)
  status                           UserStatus                @default(ACTIVE)
  emailVerified                    Boolean                   @default(false)
  emailVerifiedAt                  DateTime?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt
  subscriptions                    Subscription[]
  listings                         Listing[]
  portalAccounts                   UserPortalAccount[]
  refreshTokens                    RefreshToken[]
  organizationMemberships          OrganizationMembership[]
  organizationApplications         OrganizationApplication[]
  reviewedOrganizationApplications OrganizationApplication[] @relation("OrganizationApplicationReviewer")
  emailVerificationCodes           EmailVerificationCode[]
  passwordChangeCodes              PasswordChangeCode[]
}

model Organization {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String
  type                 OrganizationType
  country              String
  city                 String
  district             String
  address              String
  phone                String?
  taxNumber            String?
  taxOffice            String?
  businessEmail        String?
  authorizedPersonName String?
  licenseNumber        String?
  status               OrganizationStatus       @default(ACTIVE)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          OrganizationMembership[]
}

model OrganizationApplication {
  id                   String                        @id @default(uuid()) @db.Uuid
  userId               String                        @db.Uuid
  organizationName     String
  organizationType     OrganizationType
  country              String
  city                 String
  district             String
  taxOffice            String?
  vkn                  String?
  authorizedPersonName String
  companyPhone         String?
  businessEmail        String?
  address              String
  licenseNumber        String?
  status               OrganizationApplicationStatus @default(PENDING)
  rejectionReason      String?                       @db.Text
  reviewedById         String?                       @db.Uuid
  reviewedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                         @relation("OrganizationApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([organizationType, status])
  @@index([reviewedById, createdAt])
}

model EmailVerificationCode {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  email             String
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(5)
  resendAvailableAt DateTime
  sentAt            DateTime  @default(now())
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([invalidatedAt])
}

model PasswordChangeCode {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(5)
  resendAvailableAt DateTime
  sentAt            DateTime  @default(now())
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([invalidatedAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String          @db.Uuid
  action      AuditAction
  entityType  AuditEntityType
  entityId    String          @db.Uuid
  changes     Json?
  ipAddress   String?         @db.VarChar(64)
  userAgent   String?         @db.VarChar(512)
  createdAt   DateTime        @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  monthlyPrice  Decimal        @db.Decimal(12, 2)
  listingLimit  Int
  portalLimit   Int
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  planId    String             @db.Uuid
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime
  expiresAt DateTime?
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
}

model Listing {
  id                 String               @id @default(uuid()) @db.Uuid
  listingNo          String               @unique @default(cuid())
  ownerId            String               @db.Uuid
  title              String
  description        String               @db.Text
  price              Decimal              @db.Decimal(14, 2)
  currency           Currency             @default(TRY)
  listingType        ListingType
  propertyType       PropertyType
  city               String
  district           String
  neighborhood       String?
  address            String
  latitude           Decimal?             @db.Decimal(10, 7)
  longitude          Decimal?             @db.Decimal(10, 7)
  status             ListingStatus        @default(DRAFT)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media              ListingMedia[]
  publications       ListingPublication[]
  residentialDetails ResidentialDetails?
  features           ListingFeature[]

  @@index([ownerId, status])
  @@index([city, district])
}

model ResidentialDetails {
  listingId          String             @id @db.Uuid
  grossArea          Decimal?           @db.Decimal(10, 2)
  netArea            Decimal?           @db.Decimal(10, 2)
  roomCount          String?
  buildingAge        Int?
  floorNumber        Int?
  totalFloors        Int?
  heatingType        HeatingType?
  bathroomCount      Int?
  kitchenType        KitchenType?
  hasBalcony         Boolean?
  hasElevator        Boolean?
  parkingType        ParkingType?
  isFurnished        Boolean?
  occupancyStatus    OccupancyStatus?
  isInComplex        Boolean?
  complexName        String?
  monthlyFee         Decimal?           @db.Decimal(12, 2)
  isCreditEligible   Boolean?
  energyCertificate  EnergyCertificate?
  titleDeedStatus    TitleDeedStatus?
  advertiserType     AdvertiserType?
  isExchangeAccepted Boolean?
  housingType        HousingType?
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model FeatureDefinition {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  label     String
  category  FeatureCategory
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  listings  ListingFeature[]

  @@index([category, isActive])
}

model ListingFeature {
  listingId           String            @db.Uuid
  featureDefinitionId String            @db.Uuid
  listing             Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  featureDefinition   FeatureDefinition @relation(fields: [featureDefinitionId], references: [id], onDelete: Restrict)

  @@id([listingId, featureDefinitionId])
  @@index([featureDefinitionId])
}

model ListingMedia {
  id           String           @id @default(uuid()) @db.Uuid
  listingId    String           @db.Uuid
  type         ListingMediaType @default(IMAGE)
  url          String
  storageKey   String           @default("")
  originalName String?
  mimeType     String           @default("image/webp")
  fileSize     Int              @default(0)
  width        Int?
  height       Int?
  sortOrder    Int              @default(0)
  isCover      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model Portal {
  id               String               @id @default(uuid()) @db.Uuid
  code             String               @unique
  name             String
  adapterKey       String               @unique
  isActive         Boolean              @default(true)
  connectionType   String               @default("REST_API")
  credentialSchema Json?
  documentationUrl String?
  logoUrl          String?
  userAccounts     UserPortalAccount[]
  publications     ListingPublication[]
}

model UserPortalAccount {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @db.Uuid
  portalId             String           @db.Uuid
  credentialsEncrypted String           @db.Text
  connectionStatus     ConnectionStatus @default(NOT_TESTED)
  lastCheckedAt        DateTime?
  lastError            String?          @db.Text
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal               Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@unique([userId, portalId])
  @@index([portalId, connectionStatus])
}

model ListingPublication {
  id                String               @id @default(uuid()) @db.Uuid
  listingId         String               @db.Uuid
  portalId          String               @db.Uuid
  status            PublicationStatus    @default(PENDING)
  externalListingId String?
  externalUrl       String?
  lastError         String?              @db.Text
  publishedAt       DateTime?
  updatedAt         DateTime             @updatedAt
  listing           Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  portal            Portal               @relation(fields: [portalId], references: [id], onDelete: Restrict)
  attempts          PublicationAttempt[]

  @@unique([listingId, portalId])
  @@index([portalId, status])
}

model PublicationAttempt {
  id                   String             @id @default(uuid()) @db.Uuid
  listingPublicationId String             @db.Uuid
  action               PublicationAction
  status               AttemptStatus      @default(STARTED)
  attemptNumber        Int
  requestPayload       Json?
  responsePayload      Json?
  errorMessage         String?            @db.Text
  createdAt            DateTime           @default(now())
  listingPublication   ListingPublication @relation(fields: [listingPublicationId], references: [id], onDelete: Cascade)

  @@unique([listingPublicationId, action, attemptNumber])
  @@index([listingPublicationId, createdAt])
}
